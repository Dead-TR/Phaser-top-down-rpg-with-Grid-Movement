{"ast":null,"code":"export const createTimeouts=()=>{const timeouts=[];const pushTimeout=function(f){let time=arguments.length>1&&arguments[1]!==undefined?arguments[1]:0;const t=setTimeout(()=>{f();},time);timeouts.push(t);};const clearTimeouts=()=>{timeouts.forEach(t=>{clearTimeout(t);});timeouts.length=0;};return{pushTimeout,clearTimeouts};};","map":{"version":3,"names":["createTimeouts","timeouts","pushTimeout","f","time","arguments","length","undefined","t","setTimeout","push","clearTimeouts","forEach","clearTimeout"],"sources":["/home/usr01/prj/TR/Trapped/Phaser-top-down-rpg-with-Grid-Movement/src/utils/createTimeout.ts"],"sourcesContent":["export const createTimeouts = () => {\n  const timeouts: NodeJS.Timeout[] = [];\n\n  const pushTimeout = (f: () => void, time: number = 0) => {\n    const t = setTimeout(() => {\n      f();\n    }, time);\n\n    timeouts.push(t);\n  };\n\n  const clearTimeouts = () => {\n    timeouts.forEach((t) => {\n      clearTimeout(t);\n    });\n    timeouts.length = 0;\n  };\n\n  return {\n    pushTimeout,\n    clearTimeouts,\n  };\n};\n"],"mappings":"AAAA,MAAO,MAAM,CAAAA,cAAc,CAAGA,CAAA,GAAM,CAClC,KAAM,CAAAC,QAA0B,CAAG,EAAE,CAErC,KAAM,CAAAC,WAAW,CAAG,QAAAA,CAACC,CAAa,CAAuB,IAArB,CAAAC,IAAY,CAAAC,SAAA,CAAAC,MAAA,IAAAD,SAAA,MAAAE,SAAA,CAAAF,SAAA,IAAG,CAAC,CAClD,KAAM,CAAAG,CAAC,CAAGC,UAAU,CAAC,IAAM,CACzBN,CAAC,CAAC,CAAC,CACL,CAAC,CAAEC,IAAI,CAAC,CAERH,QAAQ,CAACS,IAAI,CAACF,CAAC,CAAC,CAClB,CAAC,CAED,KAAM,CAAAG,aAAa,CAAGA,CAAA,GAAM,CAC1BV,QAAQ,CAACW,OAAO,CAAEJ,CAAC,EAAK,CACtBK,YAAY,CAACL,CAAC,CAAC,CACjB,CAAC,CAAC,CACFP,QAAQ,CAACK,MAAM,CAAG,CAAC,CACrB,CAAC,CAED,MAAO,CACLJ,WAAW,CACXS,aACF,CAAC,CACH,CAAC"},"metadata":{},"sourceType":"module"}