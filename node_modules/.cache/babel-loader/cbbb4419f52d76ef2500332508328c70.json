{"ast":null,"code":"import{useEffect,useState}from\"react\";import{inventoryManager}from\"managers/InventoryManager\";export const useEtheria=()=>{const[etheriaAmt,setEtheriaAmt]=useState(inventoryManager.etheria);useEffect(()=>{const rmEth=inventoryManager.listener(\"etheria\",v=>setEtheriaAmt(v));return()=>rmEth();},[]);const addEtheria=v=>inventoryManager.setEtheria(v,'add');const setEtheria=v=>inventoryManager.setEtheria(v,'set');return{etheria:etheriaAmt,addEtheria,setEtheria};};","map":{"version":3,"names":["useEffect","useState","inventoryManager","useEtheria","etheriaAmt","setEtheriaAmt","etheria","rmEth","listener","v","addEtheria","setEtheria"],"sources":["/home/usr01/prj/TR/Trapped/trapped/game/src/hooks/etheria.ts"],"sourcesContent":["import { useEffect, useState } from \"react\";\n\nimport { inventoryManager } from \"managers/InventoryManager\";\n\nexport const useEtheria = () => {\n  const [etheriaAmt, setEtheriaAmt] = useState(inventoryManager.etheria);\n\n  useEffect(() => {\n    const rmEth = inventoryManager.listener(\"etheria\", (v) => setEtheriaAmt(v));\n\n    return () => rmEth();\n  }, []);\n\n  const addEtheria = (v: number) => inventoryManager.setEtheria(v, 'add');\n  const setEtheria = (v: number) => inventoryManager.setEtheria(v, 'set');\n\n  return { etheria: etheriaAmt, addEtheria, setEtheria };\n};\n"],"mappings":"AAAA,OAASA,SAAS,CAAEC,QAAQ,KAAQ,OAAO,CAE3C,OAASC,gBAAgB,KAAQ,2BAA2B,CAE5D,MAAO,MAAM,CAAAC,UAAU,CAAGA,CAAA,GAAM,CAC9B,KAAM,CAACC,UAAU,CAAEC,aAAa,CAAC,CAAGJ,QAAQ,CAACC,gBAAgB,CAACI,OAAO,CAAC,CAEtEN,SAAS,CAAC,IAAM,CACd,KAAM,CAAAO,KAAK,CAAGL,gBAAgB,CAACM,QAAQ,CAAC,SAAS,CAAGC,CAAC,EAAKJ,aAAa,CAACI,CAAC,CAAC,CAAC,CAE3E,MAAO,IAAMF,KAAK,CAAC,CAAC,CACtB,CAAC,CAAE,EAAE,CAAC,CAEN,KAAM,CAAAG,UAAU,CAAID,CAAS,EAAKP,gBAAgB,CAACS,UAAU,CAACF,CAAC,CAAE,KAAK,CAAC,CACvE,KAAM,CAAAE,UAAU,CAAIF,CAAS,EAAKP,gBAAgB,CAACS,UAAU,CAACF,CAAC,CAAE,KAAK,CAAC,CAEvE,MAAO,CAAEH,OAAO,CAAEF,UAAU,CAAEM,UAAU,CAAEC,UAAW,CAAC,CACxD,CAAC"},"metadata":{},"sourceType":"mo