{"ast":null,"code":"import{fastFloor}from\"utils\";export const getEdgeRadiusPoints=(x,y,radius,tileWidth,tileHeight)=>{const leftTopX=fastFloor((x-radius)/tileWidth);const leftTopY=fastFloor((y-radius)/tileHeight);const rightBottomX=Math.ceil((x+radius)/tileWidth);const rightBottomY=Math.ceil((y+radius)/tileHeight);return{leftTopX,leftTopY,rightBottomX,rightBottomY};};","map":{"version":3,"names":["fastFloor","getEdgeRadiusPoints","x","y","radius","tileWidth","tileHeight","leftTopX","leftTopY","rightBottomX","Math","ceil","rightBottomY"],"sources":["/home/usr01/prj/TR/Trapped/Phaser-top-down-rpg-with-Grid-Movement/src/game/entities/utils/getEdgePoints.ts"],"sourcesContent":["import { fastFloor } from \"utils\";\n\nexport const getEdgeRadiusPoints = (\n  x: number,\n  y: number,\n  radius: number,\n  tileWidth: number,\n  tileHeight: number,\n) => {\n  const leftTopX = fastFloor((x - radius) / tileWidth);\n  const leftTopY = fastFloor((y - radius) / tileHeight);\n  const rightBottomX = Math.ceil((x + radius) / tileWidth);\n  const rightBottomY = Math.ceil((y + radius) / tileHeight);\n\n  return {\n    leftTopX,\n    leftTopY,\n    rightBottomX,\n    rightBottomY,\n  };\n};\n"],"mappings":"AAAA,OAASA,SAAS,KAAQ,OAAO,CAEjC,MAAO,MAAM,CAAAC,mBAAmB,CAAGA,CACjCC,CAAS,CACTC,CAAS,CACTC,MAAc,CACdC,SAAiB,CACjBC,UAAkB,GACf,CACH,KAAM,CAAAC,QAAQ,CAAGP,SAAS,CAAC,CAACE,CAAC,CAAGE,MAAM,EAAIC,SAAS,CAAC,CACpD,KAAM,CAAAG,QAAQ,CAAGR,SAAS,CAAC,CAACG,CAAC,CAAGC,MAAM,EAAIE,UAAU,CAAC,CACrD,KAAM,CAAAG,YAAY,CAAGC,IAAI,CAACC,IAAI,CAAC,CAACT,CAAC,CAAGE,MAAM,EAAIC,SAAS,CAAC,CACxD,KAAM,CAAAO,YAAY,CAAGF,IAAI,CAACC,IAAI,CAAC,CAACR,CAAC,CAAGC,MAAM,EAAIE,UAAU,CAAC,CAEzD,MAAO,CACLC,QAAQ,CACRC,QAAQ,CACRC,YAAY,CACZG,YACF,CAAC,CACH,CAAC"},"metadata":{},"sourceType":"module"}